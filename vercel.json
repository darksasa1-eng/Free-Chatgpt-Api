{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/v1/chat", "destination": "/api/chat" },
    { "source": "/chat", "destination": "/api/chat" },
    { "source": "/v1/models", "destination": "/api/models" },
    { "source": "/v1/image", "destination": "/api/image" },
    { "source": "/v1/summarize", "destination": "/api/summarize" },
    { "source": "/v1/translate", "destination": "/api/translate" },
    { "source": "/v1/code", "destination": "/api/code" },
    { "source": "/status", "destination": "/api/status" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/favicon.ico", "destination": "/api/favicon" },
    { "source": "/favicon.svg", "destination": "/api/favicon" },
    { "source": "/(.*)", "destination": "/api/main" }
  ]
}
